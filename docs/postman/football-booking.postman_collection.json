            "pm.test('So tien lay tu API booking-service, khong tin client', () => pm.expect(b.amount).to.eql(675000));",
            "pm.test('Trang thai ban dau INIT', () => pm.expect(b.status).to.eql('INIT'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
