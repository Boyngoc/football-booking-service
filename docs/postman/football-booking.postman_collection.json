{
  "info": {
    "name": "Football Booking System - KT1",
    "_postman_id": "f00tba11-b00c-4a51-9e2d-000000000001",
    "description": "Bo kiem thu API he thong quan ly dat lich san bong da.\n\nThu tu chay: Health -> Auth -> Field -> Booking -> Payment -> Bao mat.\nBien {{token}}, {{tokenOwner}}, {{bookingId}}, {{paymentId}} duoc luu tu dong sau khi chay cac request tuong ung.\nBien {{bookingDate}} tu dong = hom nay + 7 ngay.\n\nChu so huu: Linh (booking) - Hung (field) - Nhat (payment) - Hoang (auth/bao mat).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Ngay dat san = hom nay + 7 ngay, de khong bao gio roi vao qua khu",
          "const d = new Date();",
          "d.setDate(d.getDate() + 7);",
          "const iso = d.toISOString().substring(0, 10);",
          "pm.collectionVariables.set('bookingDate', iso);",
          "",
          "// Ngay hom qua, dung cho ca kiem thu R5 (dat san ngay qua khu)",
          "const y = new Date();",
          "y.setDate(y.getDate() - 1);",
          "pm.collectionVariables.set('pastDate', y.toISOString().substring(0, 10));"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseAuth", "value": "http://localhost:8080" },
    { "key": "baseBooking", "value": "http://localhost:8081" },
    { "key": "baseField", "value": "http://localhost:8082" },
    { "key": "basePayment", "value": "http://localhost:8083" },
    { "key": "token", "value": "" },
    { "key": "tokenOwner", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "bookingDate", "value": "" },
    { "key": "pastDate", "value": "" }
  ],
