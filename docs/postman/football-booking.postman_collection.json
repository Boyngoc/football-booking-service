            "body": { "mode": "raw", "raw": "{\n  \"username\": \"khach01\",\n  \"password\": \"123456\",\n  \"fullName\": \"Le Van Cuong\",\n  \"phone\": \"0987654321\"\n}" },
            "url": "{{baseAuth}}/api/auth/register"
          }
        },
        {
          "name": "Dang nhap KHACH -> luu {{token}}",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Dang nhap thanh cong 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "if (b.token) { pm.collectionVariables.set('token', b.token); }",
            "pm.test('Vai tro la CUSTOMER', () => pm.expect(b.role).to.eql('CUSTOMER'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"khach01\",\n  \"password\": \"123456\"\n}" },
